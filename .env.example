# ============================================================================
# LOCAL DEVELOPMENT (native PostgreSQL)
# ============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/aurelia?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/aurelia?schema=public"

# ============================================================================
# PRODUCTION on Supabase + Vercel (Supabase is PostgreSQL)
# ----------------------------------------------------------------------------
# From Supabase → Project Settings → Database → Connection string.
#  - DATABASE_URL = "Transaction" pooler (port 6543) + ?pgbouncer=true
#  - DIRECT_URL   = "Direct connection" (port 5432), used by prisma migrate
# ============================================================================
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public site URL (SEO metadata, sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin authentication (seed creates this admin user)
ADMIN_EMAIL="admin@aurelia.id"
ADMIN_PASSWORD="aurelia-admin"

# Long random string used to sign the admin session cookie
AUTH_SECRET="please-change-this-to-a-long-random-secret-string"

# ============================================================================
# SUPABASE STORAGE (image uploads)
# ----------------------------------------------------------------------------
# Required on Vercel (its filesystem is read-only, so local /public/uploads
# cannot be written). Leave blank locally to fall back to /public/uploads.
# Keys: Supabase → Project Settings → API.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"
